// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Blog[]
}

model Booking {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  fromLocation  String
  toLocation    String
  departureDate DateTime
  returnDate    DateTime
  travelClass   String
  adults        Int
  infants       Int
  createdAt     DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())
}
model BlogCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Blog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  slug         String   @unique
  categories   String[]
  content      String
  image        String
  focusKeyword String   @default("")
  metaTitle    String
  metaDesc     String
  metaKeywords String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       User     @relation(fields: [authorId], references: [id])
  authorId     String   @db.ObjectId
  faqs         Faq[]
}

model Faq {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  question String
  answer   String
  blog     Blog   @relation(fields: [blogId], references: [id])
  blogId   String @db.ObjectId
}

model AirlinePolicyCategory {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  name      String          @unique
  policies  AirlinePolicy[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model AirlinePolicy {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  excerpt         String?
  content         String
  policyType      String
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]              @default([])
  status          String                @default("DRAFT")
  publishedAt     DateTime?
  categoryId      String                @db.ObjectId
  category        AirlinePolicyCategory @relation(fields: [categoryId], references: [id])
  faqs Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model FlightDestination {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  title           String
  slug            String   @unique

  destination     String
  country         String
  airportCode     String?

  excerpt         String?
  content         String

  heroImage       String?

  sections        Json?
  relatedFlights  Json?
  faqs            Json?

  focusKeyword    String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[] @default([])

  status          String   @default("DRAFT")
  publishedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([destination])
  @@index([country])
  @@index([status])
  @@index([createdAt])
}

model Deal {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  title           String
  slug            String   @unique
  excerpt         String?
  content         String

  featuredImage   String?

  tags            String[] @default([])
  dealType        String?
  faqs            Json?

  focusKeyword    String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[] @default([])
  canonicalUrl    String?

  status          String   @default("DRAFT")
  isFeatured      Boolean  @default(false)

  publishedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([dealType])
  @@index([status])
  @@index([isFeatured])
  @@index([publishedAt])
  @@index([createdAt])
}